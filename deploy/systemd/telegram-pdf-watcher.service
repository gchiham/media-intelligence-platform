[Unit]
Description=Telegram PDF watcher (scripts/telegram_pdf_watcher.py)
# La app corre en Docker, pero este script no -- necesita la sesion de
# Telethon en disco (ver instrucciones de instalacion mas abajo), asi que va
# directo con el venv del host, igual que worker_prefetch.py en Chepita.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/app
EnvironmentFile=/home/ubuntu/app/.env
ExecStart=/home/ubuntu/venv/bin/python scripts/telegram_pdf_watcher.py
Restart=on-failure
RestartSec=15
# Systemd no da TTY -- si la sesion de Telethon no esta autorizada todavia,
# client.start() se queda esperando input() y el servicio nunca arranca.
# Hace falta el login interactivo manual (ver instalacion) antes de habilitar
# esta unit.
StandardInput=null
StandardOutput=append:/home/ubuntu/telegram_pdf_watcher.log
StandardError=append:/home/ubuntu/telegram_pdf_watcher.log

[Install]
WantedBy=multi-user.target
